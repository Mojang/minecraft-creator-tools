{
  "$schema": "../../../schemas/dataform/form-definition.schema.json",
  "id": "minecraft:projectile",
  "versionIntroduced": "1.20.10",
  "summarizer": {
    "phrases": [
      {
        "visibility": [
          {
            "field": "projectile_entity",
            "comparison": "defined"
          }
        ],
        "tokens": [
          {
            "type": "literal",
            "text": "shoots "
          },
          {
            "type": "value",
            "field": "projectile_entity"
          }
        ]
      }
    ]
  },
  "fields": [
    {
      "id": "projectile_entity",
      "dataType": "string",
      "description": "Which entity is to be fired as a projectile.",
      "title": "Projectile Entity",
      "isRequired": true,
      "validity": [
        {
          "comparison": "pattern",
          "value": "^(?:\\w+(?:\\.\\w+)*:(?=\\w))?(?:\\w+(?:\\.\\w+)*)(?:<((?:\\w+(?:\\.\\w+)*:(?=\\w))?\\w+(?:\\.\\w+)*)*>)?$"
        }
      ]
    },
    {
      "id": "minimum_critical_power",
      "title": "Minimum Critical Power",
      "description": "Specifies how long a player must charge a projectile for it to critically hit.",
      "dataType": "float",
      "defaultValue": 0
    }
  ],
  "description": "Defines an item as a projectile that can be shot from dispensers or used as ammunition with minecraft:shooter. When combined with minecraft:throwable, this component specifies which entity is spawned when the item is thrown.",
  "samples": {
    "sample": [
      {
        "path": "sample",
        "content": {
          "minimum_critical_power": 1.25,
          "projectile_entity": "arrow"
        }
      }
    ]
  },
  "title": "Item Projectile"
}