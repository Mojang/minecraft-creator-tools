{
  "$schema": "../../../schemas/dataform/form-definition.schema.json",
  "summarizer": {
    "phrases": [
      {
        "tokens": [
          {
            "type": "literal",
            "text": "has connection rules for adjacent blocks"
          }
        ]
      }
    ]
  },
  "id": "minecraft:connection_rule",
  "versionIntroduced": "1.21.130",
  "note": "Lets a custom block control whether other blocks with connection behavior (fences, walls, bars, glass panes) may visually connect to it. Released alongside the new `minecraft:has_fence_connections` VanillaBlockTag.",
  "note2": "Available without the Upcoming Creator Features experimental toggle for block format versions 1.26.0 or higher.",
  "fields": [
    {
      "id": "accepts_connections_from",
      "title": "Accepts Connections From",
      "description": "The type of block allowed to connect to this block. Note that the \"only_fences\" option allows connections from all Vanilla fences excluding NetherBrick.",
      "dataType": "stringEnum",
      "defaultValue": "all",
      "choices": [
        {
          "id": "all",
          "title": "All"
        },
        {
          "id": "none",
          "title": "None"
        },
        {
          "id": "only_fences",
          "title": "Only fences"
        }
      ],
      "mustMatchChoices": true,
      "samples": {
        "/vanilla/behavior_pack/blocks/red_shrub.block.json": [
          {
            "path": "/minecraft:block/components/minecraft:connection_rule/",
            "content": "none"
          }
        ],
        "/vanilla/behavior_pack/blocks/shelf_mushroom_block.json": [
          {
            "path": "/minecraft:block/components/minecraft:connection_rule/",
            "content": "none"
          }
        ]
      }
    },
    {
      "id": "enabled_directions",
      "title": "Enabled Directions",
      "description": "The cardinal directions that connection is enabled for. Note that if \"none\" is specified for \"accepts_connections_from\", this field will not be used.",
      "dataType": "stringArray",
      "defaultValue": [
        "south",
        "north",
        "east",
        "west"
      ],
      "mustBeUnique": true,
      "choices": [
        {
          "id": "east",
          "title": "East"
        },
        {
          "id": "north",
          "title": "North"
        },
        {
          "id": "south",
          "title": "South"
        },
        {
          "id": "west",
          "title": "West"
        }
      ],
      "mustMatchChoices": true
    }
  ],
  "description": "Defines whether other blocks such as fences, walls, bars, and glass panes are allowed to connect to this block.",
  "title": "Block Connection Rule",
  "samples": {
    "/vanilla/behavior_pack/blocks/red_shrub.block.json": [
      {
        "path": "/minecraft:block/components/minecraft:connection_rule/",
        "content": {
          "accepts_connections_from": "none"
        }
      }
    ],
    "/vanilla/behavior_pack/blocks/shelf_mushroom_block.json": [
      {
        "path": "/minecraft:block/components/minecraft:connection_rule/",
        "content": {
          "accepts_connections_from": "none"
        }
      }
    ]
  },
  "dataVersion": "1.26.20"
}