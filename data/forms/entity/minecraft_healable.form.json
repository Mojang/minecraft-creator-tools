{
  "$schema": "../../../schemas/dataform/form-definition.schema.json",
  "summarizer": {
    "phrases": [
      {
        "tokens": [
          {
            "type": "literal",
            "text": "can be healed by feeding it items"
          }
        ]
      },
      {
        "visibility": [
          {
            "field": "force_use",
            "comparison": "=",
            "value": true
          }
        ],
        "tokens": [
          {
            "type": "literal",
            "text": "accepts healing items even at full health"
          }
        ]
      },
      {
        "visibility": [
          {
            "field": "filters",
            "comparison": "defined"
          }
        ],
        "tokens": [
          {
            "type": "literal",
            "text": "has conditional healing requirements"
          }
        ]
      }
    ]
  },
  "description": "How entities heal",
  "note": "From 1.21.130, each entry in `items` accepts an optional `result_item` field. On a successful heal, the consumed item is replaced in the player's inventory with the specified item.",
  "fields": [
    {
      "id": "force_use",
      "title": "Whether an item can be used even if the entity is at full health",
      "dataType": "boolean",
      "samples": {
        "/vanilla/behavior_pack/entities/parrot.json": [
          {
            "path": "/minecraft:entity/components/minecraft:healable/",
            "content": true
          }
        ]
      },
      "defaultValue": false,
      "description": "Determines if item can be used regardless of entity being at full health."
    },
    {
      "id": "filters",
      "title": "Additional filters when healing happens",
      "dataType": "minecraftFilter",
      "samples": {
        "/vanilla/behavior_pack/entities/parrot.json": [
          {
            "path": "/minecraft:entity/components/minecraft:healable/",
            "content": {
              "operator": "!=",
              "test": "is_riding",
              "value": true
            }
          }
        ]
      },
      "defaultValue": {
        "AND": null,
        "NOT": null,
        "OR": null,
        "all": null,
        "all_of": null,
        "any": null,
        "any_of": null,
        "none_of": null
      },
      "subForm": {
        "id": "filters",
        "title": "Filters",
        "fields": [
          {
            "id": "domain",
            "title": "Domain",
            "description": "The domain the test should be performed in.",
            "dataType": "object"
          },
          {
            "id": "operator",
            "title": "Operator",
            "description": "The comparison to apply with 'value'.",
            "dataType": "object"
          },
          {
            "id": "subject",
            "title": "Subject",
            "description": "The subject of this filter test.",
            "dataType": "object"
          },
          {
            "id": "test",
            "title": "Test",
            "description": "The name of the test to apply.",
            "dataType": "string",
            "isRequired": true
          },
          {
            "id": "value",
            "title": "Value",
            "description": "The value being compared with the test.",
            "dataType": "object"
          }
        ],
        "dataVersion": "1.21.20"
      },
      "alternates": [
        {
          "id": "filters",
          "dataType": "object"
        }
      ],
      "description": "The filter group that defines the conditions for using this item to heal the entity."
    },
    {
      "id": "items",
      "title": "Items",
      "description": "The array of items that can be used to heal this entity.",
      "dataType": "objectArray",
      "defaultValue": [],
      "subFormId": "entity/healablecomponentfeeditem",
      "samples": {
        "/vanilla/behavior_pack/entities/llama.json": [
          {
            "path": "/minecraft:entity/components/minecraft:healable/",
            "content": [
              {
                "item": "wheat",
                "heal_amount": 2
              },
              {
                "item": "hay_block",
                "heal_amount": 10
              }
            ]
          }
        ],
        "/vanilla/behavior_pack/entities/parrot.json": [
          {
            "path": "/minecraft:entity/components/minecraft:healable/",
            "content": [
              {
                "effects": [
                  {
                    "amplifier": 0,
                    "chance": 1,
                    "duration": 1000,
                    "name": "fatal_poison"
                  }
                ],
                "heal_amount": 0,
                "item": "cookie"
              }
            ]
          }
        ]
      }
    }
  ],
  "title": "Entity Healable",
  "samples": {
