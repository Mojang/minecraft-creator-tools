{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Entity HealableComponentFeedItem",
  "properties": {
    "effects": {
      "title": "Effects",
      "description": "The effects to apply when this item is used to heal the entity.",
      "type": "array",
      "items": {
        "$ref": "./entity_healablecomponenteffect.schema.json"
      }
    },
    "heal_amount": {
      "title": "Heal Amount",
      "description": "The amount of health this entity gains when fed this item.",
      "type": "integer",
      "default": 1
    },
    "item": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ],
      "title": "Item",
      "description": "Item identifier that can be used to heal this entity.",
      "defaultSnippets": [
        {
          "label": "Item (default)",
          "description": "Use default value: [object Object]",
          "body": {}
        }
      ]
    },
    "result_item": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ],
      "title": "Result Item",
      "description": "The feed item used will transform to this item upon successful interaction.",
      "defaultSnippets": [
        {
          "label": "Result Item (default)",
          "description": "Use default value: [object Object]",
          "body": {}
        }
      ]
    }
  }
}