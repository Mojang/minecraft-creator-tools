{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Entity SpawnAoECloudSubcomponentDefinition",
  "description": "Spawns an area effect cloud at the impact point that applies potion effects to entities inside it over time",
  "properties": {
    "affect_owner": {
      "title": "Affect Owner",
      "description": "If `true`, the projectile's owner can be affected by the cloud.",
      "type": "boolean",
      "default": true
    },
    "duration": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "title": "Duration",
      "description": "How long, in seconds, the cloud persists before disappearing."
    },
    "particle": {
      "title": "Particle",
      "description": "Particle effect emitted by the cloud.",
      "type": "string",
      "enum": [
        "balloongas",
        "bleach",
        "blockforcefield",
        "blueflame",
        "breezewindexplosion",
        "bubble",
        "bubblecolumndown",
        "bubblecolumnup",
        "bubblemanual",
        "campfiresmoke",
        "campfiresmoketall",
        "candleflame",
        "carrotboost",
        "coloredflame",
        "conduit",
        "creakingcrumble",
        "crit",
        "dragonbreath",
        "dragonbreathfire",
        "dragonbreathtrail",
        "dragondestroyblock",
        "driphoney",
        "driplava",
        "dripwater",
        "dustplume",
        "electricspark",
        "enchantingtable",
        "endrod",
        "evaporation",
        "explode",
        "eyeblossomclose",
        "eyeblossomopen",
        "fallingborderdust",
        "fallingdust",
        "fireworks",
        "fireworksoverlay",
        "fireworksstarter",
        "flame",
        "food",
        "greenflame",
        "heart",
        "hugeexplosion",
        "iceballbreak",
        "iconcrack",
        "ink",
        "largeexplode",
        "largesmoke",
        "lava",
        "mobappearance",
        "mobflame",
        "mobspell",
        "mobspellambient",
        "mobspellinstantaneous",
        "myceliumdust",
        "none",
        "note",
        "obsidiantear",
        "orangepoplarleaves",
        "paleoakleaves",
        "pausemobgrowth",
        "portal",
        "portalreverse",
        "rainsplash",
        "reddust",
        "redpoplarleaves",
        "resetmobgrowth",
        "risingborderdust",
        "sculksoul",
        "shriek",
        "shulkerbullet",
        "slime",
        "smoke",
        "sneeze",
        "snowballpoof",
        "snowflake",
        "sonicexplosion",
        "soul",
        "sparkler",
        "spit",
        "stalactitedriplava",
        "stalactitedripwater",
        "sulfurcube",
        "terrain",
        "totem",
        "townaura",
        "trackingemitter",
        "vaultconnection",
        "villagerangry",
        "villagerhappy",
        "watersplash",
        "watersplashmanual",
        "waterwake",
        "wax",
        "whitesmoke",
        "windexplosion",
        "witchspell",
        "wolfarmorcrack",
        "yellowpoplarleaves"
      ],
      "default": "mobspellambient"
    },
    "potion": {
      "title": "Potion",
      "description": "Aux value of the potion whose effects the cloud applies. When `-1`, the potion is taken from the projectile entity itself.",
      "type": "integer",
      "default": -1
    },
    "radius": {
      "title": "Radius",
      "description": "Initial radius (in blocks) of the cloud.",
      "type": "number",
      "default": 0
    },
    "radius_on_use": {
      "title": "Radius On Use",
      "description": "Amount the radius shrinks (or grows) each time the cloud applies its effects. `-1` keeps the radius unchanged.",
      "type": "number",
      "default": -1
    },
    "reapplication_delay": {
      "title": "Reapplication Delay",
      "description": "Number of ticks the cloud waits before re-applying its effects to the same entity.",
      "type": "integer",
      "default": 0
    }
  }
}