{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Entity PreferredPath BlockSet",
  "properties": {
    "blocks": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "title": "Name",
                "type": "string",
                "default": ""
              },
              "states": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  }
                ],
                "title": "States"
              },
              "tags": {
                "title": "Tags",
                "type": "string",
                "default": ""
              }
            }
          }
        },
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object"
        }
      ],
      "description": "List of preferred blocks"
    },
    "cost": {
      "title": "Cost",
      "description": "Cost for preferred blocks",
      "type": "number"
    }
  }
}